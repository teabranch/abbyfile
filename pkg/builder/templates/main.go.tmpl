package main

import (
	"os"
{{- if .NeedsJSON}}
	"encoding/json"
{{- end}}

	"github.com/teabranch/abbyfile/pkg/agent"
	"github.com/teabranch/abbyfile/pkg/builtins"
{{- if or .CustomTools .Budget}}
	"github.com/teabranch/abbyfile/pkg/tools"
{{- end}}
{{- if .Sandbox}}
	"github.com/teabranch/abbyfile/pkg/sandbox"
{{- end}}
)

func main() {
	toolDefs, err := builtins.ForNames([]string{
		{{- range .Tools}}
		{{printf "%q" .}},
		{{- end}}
	})
	if err != nil {
		panic(err)
	}
{{if .CustomTools}}
	// Custom tools declared in agent frontmatter.
	{
		{{- range .CustomTools}}
		{
			def := &tools.Definition{
				Name:        {{printf "%q" .Name}},
				Command:     {{printf "%q" .Command}},
				Description: {{printf "%q" .Description}},
				{{- if .Args}}
				Args: []string{
					{{- range .Args}}
					{{printf "%q" .}},
					{{- end}}
				},
				{{- end}}
				{{- if .StdinInput}}
				StdinInput: true,
				{{- end}}
			}
			{{- if .InputSchemaJSON}}
			var schema map[string]any
			if err := json.Unmarshal([]byte({{printf "%q" .InputSchemaJSON}}), &schema); err != nil {
				panic("unmarshaling input schema for " + {{printf "%q" .Name}} + ": " + err.Error())
			}
			def.InputSchema = schema
			{{- else}}
			def.InputSchema = map[string]any{
				"type": "object",
				"properties": map[string]any{
					"args": map[string]any{
						"type":        "string",
						"description": "Command-line arguments to pass to the tool",
					},
				},
			}
			{{- end}}
			toolDefs = append(toolDefs, def)
		}
		{{- end}}
	}
{{end}}
	a, err := agent.New(
		agent.WithName({{printf "%q" .Name}}),
		agent.WithVersion({{printf "%q" .Version}}),
		agent.WithDescription({{printf "%q" .Description}}),
		agent.WithPromptFS(promptFS, "prompts/system.md"),
		agent.WithTools(toolDefs...),
		{{- if .Memory}}
		agent.WithMemory(true),
		{{- end}}
		{{- if .Sandbox}}
		agent.WithSandbox(sandbox.Config{
			AllowedDirs: []string{ {{- range $i, $d := .Sandbox.AllowedDirs}}{{if $i}}, {{end}}{{printf "%q" $d}}{{end -}} },
			Bash: sandbox.BashMode({{printf "%q" .Sandbox.Bash}}),
			AllowCommands: []string{ {{- range $i, $c := .Sandbox.AllowCommands}}{{if $i}}, {{end}}{{printf "%q" $c}}{{end -}} },
			MaxCommandTimeout: {{.Sandbox.MaxCommandTimeout}}, // {{.Sandbox.MaxCommandTimeoutText}}
		}),
		{{- end}}
		{{- if .Budget}}
		agent.WithContextBudget(tools.ContextBudget{
			MaxOutputLines: {{.Budget.MaxOutputLines}},
			MaxOutputBytes: {{.Budget.MaxOutputBytes}},
			OnOverflow: tools.OverflowStrategy({{printf "%q" .Budget.OnOverflow}}),
			HeadLines: {{.Budget.HeadLines}},
			TailLines: {{.Budget.TailLines}},
			SummaryLines: {{.Budget.SummaryLines}},
			EagerInstructions: {{.Budget.EagerInstructions}},
			{{- if .Budget.PerTool}}
			PerTool: map[string]tools.ContextBudget{
				{{- range $k, $v := .Budget.PerTool}}
				{{printf "%q" $k}}: {
					MaxOutputLines: {{$v.MaxOutputLines}},
					MaxOutputBytes: {{$v.MaxOutputBytes}},
					OnOverflow: tools.OverflowStrategy({{printf "%q" $v.OnOverflow}}),
					HeadLines: {{$v.HeadLines}},
					TailLines: {{$v.TailLines}},
					{{- if $v.InlineLarge}}
					InlineLarge: true,
					{{- end}}
				},
				{{- end}}
			},
			{{- end}}
		}),
		{{- end}}
	)
	if err != nil {
		panic(err)
	}

	os.Exit(a.Execute())
}
